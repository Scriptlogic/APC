class Car:
    def __init__(self, brand, model):
        self.brand = brand
        self.model = model
        print("Car object created")

    def display(self):
        print("Brand:", self.brand)
        print("Model:", self.model)

    def __del__(self):
        print("Car object destroyed")


c1 = Car("Toyota", "Fortuner")

c1.display()

del c1